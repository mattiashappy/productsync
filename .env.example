# Local SQLite by default; set to a postgres:// URL on Heroku.
DATABASE_URL=sqlite:///productsync.db

# Redis is required for the RQ worker. Locally: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Flask session signing key. Change in production.
SECRET_KEY=change-me-in-production

# Symmetric key used to encrypt channel API credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Public base URL where channel webhooks will be delivered (used in setup instructions only).
PUBLIC_BASE_URL=http://localhost:5000

# Set to "1" to start APScheduler inside the web dyno (recommended on Heroku free single-dyno setups).
ENABLE_SCHEDULER=1
